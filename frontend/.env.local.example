# Base URL of the FastAPI backend (see backend/app/main.py). No trailing slash.
#
# Local dev: point this at your local `uvicorn app.main:app --reload` process.
# Public/Vercel deploy: point this at the deployed backend once it exists
# (Render/Railway per CLAUDE.md's "Development Workflow" -- as of this
# frontend scaffold, the backend hasn't been deployed yet, so the Vercel
# deploy of this app has no real API to call until that env var is set
# there too).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe test-mode PUBLISHABLE key only -- pk_test_..., never the secret key
# (sk_test_...). The secret key lives only in the backend's own .env
# (backend/app/core/config.py's STRIPE_SECRET_KEY) and must never reach the
# frontend/browser. Get this from the Stripe Dashboard -> Developers ->
# API keys, with Test mode on (see SETUP.md's "Stripe (test mode)" section).
# Used by frontend/app/checkout/page.tsx (@stripe/stripe-js's loadStripe) to
# mount Stripe Elements client-side -- the actual PaymentIntent is still
# created server-side (POST /create-payment-intent), since Elements needs a
# client_secret the frontend cannot generate on its own.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
